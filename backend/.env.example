# ═══════════════════════════════════════════════════════════
#  ProjectOS — Backend Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (Neon / PostgreSQL) ─────────────────────────────
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_at_least_64_chars_long

# ── URLs ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Cloudinary (File Storage) ────────────────────────────────
# Format: cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ── SMTP / Email (Brevo recommended) ─────────────────────────
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=465
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SENDER_NAME=ProjectOS
SENDER_EMAIL=noreply@yourdomain.com

# ── App ───────────────────────────────────────────────────────
APP_NAME=ProjectOS

# ── Redis (Optional) ─────────────────────────────────────────
# When set, enables:
#   • BullMQ email queue with retries and rate limiting
#   • Socket.io Redis adapter for multi-instance deployments
# Leave blank to use direct SMTP + in-memory Socket.io (single instance)
# Format: redis://default:password@host:port  or  rediss:// for TLS
REDIS_URL=
